<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
 
<mapper namespace="com.sweeper.car.dao.MapDAO">
	<select id="getPointsByDateAndCar" resultType ="com.sweeper.car.dto.MapDTO">
		SELECT *
		FROM points
		<![CDATA[WHERE noise < 90 AND frequency < 120]]>
		GROUP BY date, car_num;
		
	</select>
</mapper>