<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
 
<mapper namespace="com.sweeper.car.dao.LocationDAO">

	<select id="getCoordinates" resultType ="map">
		SELECT * 
		FROM points
		WHERE date = #{date}
        ORDER BY time ASC;
	</select>
</mapper>